@if (Model?.Items?.Any() == true)
{
    <nav class="main-nav">
        <ul class="nav navbar-nav">

            @foreach (var item in Model.Items)
            {
                @RenderMenuItem(item)
            }

        </ul>
    </nav>
}

@helper RenderMenuItem(SFA.DAS.TeachInFurtherEducation.Web.Models.NavigationMenuItem item)
{
    var hasChildren = item.HasChildren;

    <li class="nav-item @(hasChildren ? "dropdown" : "")">
        <a class="nav-link @(hasChildren ? "dropdown-toggle" : "")"
           href="@(hasChildren ? "#" : item.Url)"
           @(hasChildren ? "data-bs-toggle=\"dropdown\" role=\"button\" aria-expanded=\"false\"" : "")
           target="@(item.OpenInNewTab ? "_blank" : "_self")">

            @item.Title
        </a>

        @if (hasChildren)
        {
            <ul class="dropdown-menu">
                @foreach (var child in item.Children)
                {
                    if (child.HasChildren)
                    {
                        <li class="dropdown-submenu">
                            @RenderMenuItem(child)
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="dropdown-item"
                               href="@child.Url"
                               target="@(child.OpenInNewTab ? "_blank" : "_self")">
                                @child.Title
                            </a>
                        </li>
                    }
                }
            </ul>
        }
    </li>
}